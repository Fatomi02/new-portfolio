# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — never commit real keys.

# ─── Site address ────────────────────────────────────────────────
# Leave this unset on Vercel: the production domain is picked up
# automatically, so canonical URLs, Open Graph tags, the sitemap and the
# RSS feed are correct without any configuration. Set it only when you put
# a custom domain in front of the site.

NEXT_PUBLIC_SITE_URL=

# ─── Contact form ────────────────────────────────────────────────
# Without RESEND_API_KEY the form still works: submissions are logged
# to the server console instead of being emailed. That is enough for
# local development, and it means the site runs with no secrets at all.
#
# To send real email:
#   1. Create a free account at https://resend.com (no card required)
#   2. Create an API key and paste it below
#   3. Verify your sending domain, then set CONTACT_FROM_EMAIL to an
#      address at that domain. Until you do, leave CONTACT_FROM_EMAIL
#      unset and Resend's shared onboarding@resend.dev sender is used,
#      which only delivers to your own account email.

RESEND_API_KEY=

# Where enquiries land. Defaults to `email` in content/profile.ts.
CONTACT_TO_EMAIL=

# The From: address. Must be on a domain verified with Resend.
CONTACT_FROM_EMAIL=
